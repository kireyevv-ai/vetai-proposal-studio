# Пример переменных окружения. НЕ содержит реальных секретов.
# Скопируйте файл в .env и заполните значения локально. .env в .gitignore.

# --- AI-провайдер ---
# Основной провайдер — GigaChat API. Значение AI_PROVIDER=mock включает
# безопасный локальный режим без обращения к внешнему API (для демонстрации
# и тестов, если ключа нет).
AI_PROVIDER=gigachat

# GIGACHAT_AUTH_KEY — это КЛЮЧ АВТОРИЗАЦИИ (длинная строка Base64), а НЕ
# access-токен. Временный токен приложение получает автоматически.
#
# Где взять ключ:
#   developers.sber.ru -> вход через Sber ID -> GigaChat / Studio -> проект ->
#   "Ключи API" / "Авторизационные данные" -> создать ключ.
# Кабинет показывает Client ID и Client Secret, а также готовый ключ авторизации.
# Готовый ключ — это base64("<Client ID>:<Client Secret>").
# Если дан только Client ID и Client Secret, соберите ключ самостоятельно:
#   Windows PowerShell:
#     [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("ClientID:ClientSecret"))
#   Пример: при Client ID=abc-123 и Client Secret=xyz-987 ключ = base64("abc-123:xyz-987")
#
# Ключ авторизации должен соответствовать выбранному scope (ниже):
#   GIGACHAT_API_PERS — физлицо; GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлицо.
#
# Читается ТОЛЬКО из переменных окружения, никогда не попадает в код, логи и
# репозиторий (REQ-33, REQ-34). НЕ коммитьте этот файл в Git.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Необязательно: модель и адреса API (значения по умолчанию указаны ниже).
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Необязательно: доверенный корневой сертификат Минцифры (проверка TLS не
# отключается — можно лишь указать свой CA).
# GIGACHAT_CA_BUNDLE_FILE=
# Таймаут обращения к провайдеру, секунды (по умолчанию 60).
# AI_TIMEOUT_SECONDS=60

# --- База данных ---
# Необязательно. Если не указано, используется data/vetai_proposal_studio.db
VETAI_DB_PATH=
